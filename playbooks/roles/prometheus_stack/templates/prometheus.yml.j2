# =============================================================================
# Prometheus configuration — managed by Ansible
# =============================================================================
# This configures Prometheus to:
#   1. Serve its own web interface on port {{ prometheus_port | default('9090') }}
#   2. Scrape Node Exporter on ALL cluster infrastructure nodes
#      (control-plane + workers + haproxy + monitoring)
#   3. Scrape HAProxy stats on load balancer nodes (port 8404/stats)
#   4. Scrape its own metrics for self-monitoring
# =============================================================================

global:
  scrape_interval: "{{ prometheus_scrape_interval | default('15s') }}"
  evaluation_interval: 15s

# =============================================================================
# Rule files — Prometheus loads ALL .yml/.yaml files from this directory
# =============================================================================

rule_files: []

# =============================================================================
# Scrape configs — the targets Prometheus pulls metrics from
# =============================================================================

scrape_configs:

  # ---------------------------------------------------------------------------
  # Self-monitoring: Prometheus scrapes its own metrics
  # ---------------------------------------------------------------------------
  - job_name: "prometheus-self"
    scrape_interval: 5s
    static_configs:
      - targets:
          - "localhost:{{ prometheus_port | default('9090') }}"
        labels:
          group: "monitoring"
          host: "{{ ansible_facts['hostname'] | default('localhost') }}"

  # ---------------------------------------------------------------------------
  # Cluster nodes: scrape Node Exporter on every node in the cluster group
  # (control-plane + workers + haproxy + monitoring)
  # ---------------------------------------------------------------------------
  - job_name: "kubernetes-cluster"
    scrape_interval: "{{ prometheus_scrape_interval | default('15s') }}"
    static_configs:
      - targets:
{% for target in prometheus_scrape_targets | default([]) %}
          - "{{ target }}"
{% endfor %}
        labels:
          group: "kubernetes-cluster"
          metric: "node-exporter"

  # ---------------------------------------------------------------------------
  # HAProxy stats: scrape the HAProxy stats page for load balancer metrics
  # ---------------------------------------------------------------------------
  - job_name: "haproxy-stats"
    scrape_interval: "{{ prometheus_scrape_interval | default('15s') }}"
    metrics_path: /stats
    static_configs:
      - targets:
{% for target in haproxy_stats_targets | default([]) %}
          - "{{ target }}"
{% endfor %}
        labels:
          group: "cluster-infrastructure"
          metric: "haproxy-stats"
{% if groups['haproxy'] | default([]) | length == 0 %}
    # No HAProxy targets found — job will show as UP with no data, which is harmless
{% endif %}