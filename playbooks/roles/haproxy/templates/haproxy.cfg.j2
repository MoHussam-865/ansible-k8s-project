# =============================================================================
# HAProxy configuration template — dynamically generated by Ansible
# =============================================================================
# This template generates the HAProxy configuration by looping over
# groups['control-plane'] to build backend server entries.
#
# Each control-plane node is registered as a backend server on port 6443.
# The frontend listens on the same port and load-balances across all masters.
# =============================================================================

global
    daemon
    maxconn 4096
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy

defaults
    log global
    mode {{ haproxy_mode }}
    option dontlognull
    option redispatch
    retries 3
    maxconn 4096
    timeout connect {{ haproxy_timeout_connect }}
    timeout client {{ haproxy_timeout_client }}
    timeout server {{ haproxy_timeout_server }}

# ---------------------------------------------------------------------------
# Frontend: Kubernetes API load balancer
# ---------------------------------------------------------------------------
frontend kubernetes-api
    bind *:{{ haproxy_frontend_port }}
    mode {{ haproxy_mode }}
    default_backend kubernetes-masters

# ---------------------------------------------------------------------------
# Backend: dynamic list of control-plane nodes
# ---------------------------------------------------------------------------
backend kubernetes-masters
    balance {{ haproxy_balance_algorithm }}
    option tcp-check
{% for host in groups['control-plane'] %}
    server {{ host }} {{ hostvars[host].ansible_facts.default_ipv4.address }}:{{ haproxy_backend_port }} check
{% endfor %}